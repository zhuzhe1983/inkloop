# Copy to config/.dev.vars on the Docker host. Never commit the real values.
LLM_API_KEY=
# Docker 内由私有代理转发到 LLM_PROXY_UPSTREAM，避免本地 Workers 运行时的证书链差异。
LLM_BASE_URL=http://llm-proxy:8788/v1
LLM_MODEL=Qwen/Qwen3.6-27B
BAIDU_MAP_AK=
# Docker 内由 Node 私有代理转发百度请求，绕过本地 Workers 运行时的证书链差异。
BAIDU_MAP_BASE_URL=http://llm-proxy:8788/baidu
