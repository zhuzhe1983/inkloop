# Tsingfly Token Hub — keep the real key only in .env or Sites runtime settings.
TSINGFLY_API_KEY=
TSINGFLY_BASE_URL=https://hub.tsingfly.com/v1

# Compatible aliases if you already use one of these names:
# TOKENHUB_API_KEY=
# APP_KEY=

# Optional. When omitted, Inkloop chooses a suitable model from /v1/models.
TSINGFLY_MODEL=
