# LLM gateway — keep the real key only in .env or Sites runtime settings.
LLM_API_KEY=
LLM_BASE_URL=

# Optional. When omitted, Inkloop chooses a suitable model from /v1/models.
LLM_MODEL=

# Baidu Maps Web Service key. Server-side only; never expose it to browser code.
BAIDU_MAP_AK=

# Optional Baidu API base URL. Docker uses its private Node proxy; local and Sites can omit it.
BAIDU_MAP_BASE_URL=

# Optional outbound HTTPS proxy. Docker uses its private Node proxy; local and Sites can omit it.
OUTBOUND_PROXY_BASE_URL=
